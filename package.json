{
  "name": "flow",
  "productName": "Flow",
  "version": "1.0.0",
  "description": "A board-driven workspace: cards, worktrees and Claude sessions in one window",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AaronRutley/flow.git"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/fix-pty-permissions.js; node scripts/brand-dev-app.js; git config core.hooksPath .githooks || true",
    "brand": "node scripts/brand-dev-app.js",
    "icons": "node scripts/extract-icons.mjs",
    "skills": "node scripts/install-skills.js",
    "vendor:editor": "npx --yes esbuild scripts/toastui-entry.js --bundle --format=iife --minify --outfile=lib/toastui-editor-all.js",
    "test": "node scripts/smoke.js",
    "prestart": "node scripts/check-install.js",
    "start": "electron .",
    "predev": "node scripts/check-install.js",
    "dev": "electron . --dev",
    "build": "electron-builder --mac --publish never",
    "dist": "electron-builder --mac",
    "sign": "codesign --force --deep --sign 'flow code signing' dist/mac-arm64/Flow.app",
    "release": "npm run build && npm run sign && rm -rf /Applications/Flow.app && cp -R dist/mac-arm64/Flow.app /Applications/Flow.app && echo 'Flow.app updated in /Applications'",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.css\" main.js preload.js setup.js scripts/*.js"
  },
  "build": {
    "appId": "com.flow.app",
    "npmRebuild": false,
    "productName": "Flow",
    "mac": {
      "identity": null,
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "index.html",
      "assets/**/*",
      "setup.html",
      "setup.js",
      "build/icon_1024.png",
      "LICENSE",
      "LICENSES.md",
      "changelog.md",
      "node_modules/**/*"
    ],
    "dmg": {
      "icon": null,
      "backgroundColor": "#ffffff"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@toast-ui/editor": "^3.2.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "sortablejs": "^1.15.7",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4"
  }
}
